# Pinned Zig toolchain, fetched by scripts/fetch-zig.ps1 (version: .zigversion)
/tools/zig/

# Zig build artifacts (zig-out/ and .zig-cache/ are the zig init defaults;
# zig-cache/ is the pre-0.11 name)
.zig-cache/
zig-cache/
zig-out/

# OS / editor cruft
Thumbs.db
Desktop.ini
.DS_Store
.vs/
.idea/

# Vendored third-party distributions. vendor/manifest.json records every URL,
# version, and SHA-256; scripts/fetch-vendor.ps1 downloads and verifies them.
# vendor/quickjs-ng stays committed: it is C source the build compiles directly,
# so it must not depend on a network fetch.
/vendor/artifacts/
/vendor/esbuild/
/vendor/typescript/
/vendor/node/
