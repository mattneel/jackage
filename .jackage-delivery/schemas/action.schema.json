{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jackage.invalid/schemas/action.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "executionPlatform": {
      "$ref": "platform.schema.json"
    },
    "outputPlatform": {
      "$ref": "platform.schema.json"
    },
    "inputs": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "input": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "input",
        "path"
      ]
    },
    "arguments": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "workingDirectory": {
      "type": "string",
      "minLength": 1
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "file",
              "directory"
            ]
          }
        },
        "required": [
          "path",
          "kind"
        ]
      }
    },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "filesystem": {
          "enum": [
            "declared-only",
            "host"
          ]
        },
        "network": {
          "enum": [
            "deny",
            "allowlisted",
            "host"
          ]
        },
        "processTreeCleanup": {
          "type": "boolean"
        },
        "stableLogicalPaths": {
          "type": "boolean"
        },
        "allowedEndpoints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "filesystem",
        "network",
        "processTreeCleanup",
        "stableLogicalPaths",
        "allowedEndpoints"
      ]
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "memoryBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "logBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "timeoutSeconds",
        "memoryBytes",
        "logBytes"
      ]
    },
    "cachePolicy": {
      "enum": [
        "release",
        "development",
        "none"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "executionPlatform",
    "outputPlatform",
    "inputs",
    "tool",
    "arguments",
    "environment",
    "workingDirectory",
    "outputs",
    "requirements",
    "limits",
    "cachePolicy"
  ]
}
