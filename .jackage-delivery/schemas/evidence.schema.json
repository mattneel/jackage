{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jackage.invalid/schemas/evidence.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "case": {
      "type": "string",
      "minLength": 1
    },
    "stage": {
      "enum": [
        "red",
        "green",
        "characterize",
        "fault",
        "regression"
      ]
    },
    "testId": {
      "type": "string",
      "minLength": 1
    },
    "platformRole": {
      "type": "string",
      "minLength": 1
    },
    "actualPlatform": {
      "type": "string",
      "minLength": 1
    },
    "command": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "cwd": {
      "type": "string",
      "minLength": 1
    },
    "startedUtc": {
      "type": "string",
      "minLength": 1
    },
    "finishedUtc": {
      "type": "string",
      "minLength": 1
    },
    "exitCode": {
      "type": [
        "integer",
        "null"
      ]
    },
    "infrastructureFailure": {
      "type": [
        "string",
        "null"
      ]
    },
    "marker": {
      "type": "string",
      "minLength": 1
    },
    "markerFound": {
      "type": "boolean"
    },
    "logPath": {
      "type": "string",
      "minLength": 1
    },
    "logSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "acceptedObservation": {
      "type": "boolean"
    },
    "sourceBefore": {
      "type": "object"
    },
    "sourceAfter": {
      "type": "object"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "caseDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "note": {
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "case",
    "stage",
    "testId",
    "platformRole",
    "actualPlatform",
    "command",
    "cwd",
    "startedUtc",
    "finishedUtc",
    "exitCode",
    "infrastructureFailure",
    "marker",
    "markerFound",
    "logPath",
    "logSha256",
    "acceptedObservation",
    "sourceBefore",
    "sourceAfter",
    "id",
    "caseDigest",
    "note"
  ]
}
