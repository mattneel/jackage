{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jackage.invalid/schemas/plan.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "dependsOn": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "action": {
            "$ref": "action.schema.json"
          }
        },
        "required": [
          "name",
          "dependsOn",
          "action"
        ]
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name",
          "action",
          "path"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "actions",
    "outputs"
  ]
}
