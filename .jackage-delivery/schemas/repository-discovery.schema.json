{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jackage.invalid/schemas/repository-discovery.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "repositoryIdentity": {
      "type": "string",
      "minLength": 1
    },
    "hostingMode": {
      "enum": [
        "pages",
        "releases",
        "hybrid"
      ]
    },
    "metadataBaseUrls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "trustRootHint": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schemaVersion",
    "repositoryIdentity",
    "hostingMode",
    "metadataBaseUrls",
    "trustRootHint"
  ]
}
