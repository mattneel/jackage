{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jackage.invalid/schemas/result.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "actionDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "status": {
      "enum": [
        "success",
        "action-failure",
        "policy-denied",
        "canceled",
        "timeout",
        "infrastructure-failure"
      ]
    },
    "exitCode": {
      "type": [
        "integer",
        "null"
      ]
    },
    "outputs": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      }
    },
    "backendIdentity": {
      "type": "string",
      "minLength": 1
    },
    "environmentDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "actionDigest",
    "status",
    "exitCode",
    "outputs",
    "backendIdentity",
    "environmentDigest",
    "diagnostics"
  ]
}
